{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "codexa-blocks/tab",
	"version": "1.0.0",
	"title": "Tab",
	"category": "codexa-blocks",
	"parent": ["codexa-blocks/tabs"],
	"description": "One tab of a Tabs block: its label, and the content that shows when it is selected.",
	"textdomain": "codexa-blocks",
	"attributes": {
		"anchor": {
			"type": "string"
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": ["codexa-blocks/activeTab"],
	"supports": {
		"anchor": true,
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js"
}
